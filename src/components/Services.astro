---
import arrowRight from "@assets/arrow-right.svg";
import lightningBolt from "@assets/lightning-bolt.svg";

const services = [
  {
    title: "Frontend Development",
    description:
      "We create fast, lightweight frontends optimized for Core Web Vitals, SEO, and long-term maintainability.",
  },
  {
    title: "Astro Development",
    description:
      "We build ultra-fast marketing sites, content platforms, and documentation using Astro and a static-first approach.",
  },
  {
    title: "Web Application Development",
    description:
      "We design and build scalable web applications tailored to real business needs, from MVPs to complex platforms.",
  },
];
---

<section id="services" class="bg-black-black px-20 py-[102px]">
  <div class="flex items-start justify-between gap-16">
    <!-- Left column -->
    <div class="flex w-[470px] shrink-0 flex-col justify-between self-stretch">
      <!-- Top: badge + heading -->
      <div class="flex flex-col gap-8">
        <span class="services-badge">Services</span>
        <h2
          class="text-h3 font-weight-h3 text-white-white m-0 leading-[--text-h3--line-height] tracking-[--text-h3--letter-spacing]"
        >
          Unique professional approach
        </h2>
      </div>

      <!-- Bottom: description + CTA -->
      <div class="flex flex-col gap-6">
        <p
          class="text-body-big font-weight-body-big text-white-white-80 m-0 max-w-[382px] leading-[--text-body-big--line-height]"
        >
          Our confidence builds trust. We make clients feel supported and
          informed by giving rational, experience-based advice and articulating
          trade-offs honestly.
        </p>
        <a href="#" class="flex items-center gap-3 no-underline">
          <span
            class="text-body-semibold font-weight-body-semibold text-white-white leading-[--text-body-semibold--line-height]"
          >
            Read More
          </span>
          <span
            class="bg-orange flex items-center justify-center rounded-full p-[6.5px]"
          >
            <img src={arrowRight.src} alt="" class="size-[17px]" />
          </span>
        </a>
      </div>
    </div>

    <!-- Right column: service cards -->
    <div class="flex w-[624px] shrink-0 flex-col gap-[25px]">
      {
        services.map((service) => (
          <div class="service-card">
            <div class="flex min-w-0 flex-1 flex-col gap-3">
              <div class="flex items-center gap-4">
                <img
                  src={lightningBolt.src}
                  alt=""
                  class="h-[37px] w-5 shrink-0"
                />
                <h3 class="text-h4 font-weight-h4 text-white-white m-0 leading-[--text-h4--line-height]">
                  {service.title}
                </h3>
              </div>
              <p class="text-small-body font-weight-small-body text-white-white-80 m-0 max-w-[452px] leading-[--text-small-body--line-height] tracking-[--text-small-body--letter-spacing]">
                {service.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 250px;
    border: 1px solid var(--color-light-purple-light-purple-40);
    background: linear-gradient(
      102.94deg,
      rgba(255, 101, 0, 0.2) 10.842%,
      rgba(175, 84, 255, 0.2) 89.158%
    );
    backdrop-filter: blur(3.3px);
    color: var(--color-light-purple-light-purple);
    font-size: var(--text-tagline);
    font-weight: var(--font-weight-tagline);
    line-height: var(--text-tagline--line-height);
    text-transform: uppercase;
    white-space: nowrap;
    width: fit-content;
  }

  .service-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 30px;
    border-radius: 12px;
    border: 2px solid var(--color-grey-grey-30);
    background: var(--color-white-white-5);
    overflow: hidden;
    box-shadow: inset 0px -1px 19.6px 0px rgba(255, 255, 255, 0.12);
  }

  /* Gradient overlay via pseudo-element for smooth opacity transition */
  .service-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        ellipse at 91% 130%,
        rgba(190, 115, 255, 1) 0%,
        rgba(165, 69, 249, 1) 8%,
        rgba(153, 46, 246, 1) 12%,
        rgba(141, 24, 243, 1) 16%,
        rgba(106, 18, 183, 0.75) 37%,
        rgba(70, 12, 122, 0.5) 58%,
        rgba(35, 6, 61, 0.25) 79%,
        transparent 100%
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.05) 0%,
        rgba(255, 255, 255, 0.05) 100%
      );
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .service-card:hover::before {
    opacity: 1;
  }
</style>
