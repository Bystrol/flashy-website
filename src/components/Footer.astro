---
import arrowRight from "@assets/arrow-right.svg";
import logoSvg from "@assets/logo.svg";
---

<footer class="bg-black-black relative z-10 px-[100px]">
  <div class="footer-card">
    <!-- Top row -->
    <div class="flex items-start justify-between">
      <!-- Left: brand -->
      <div
        class="flex w-[306px] shrink-0 flex-col justify-between self-stretch"
      >
        <div class="flex flex-col gap-4">
          <a href="/" class="flex items-center gap-1 no-underline">
            <img src={logoSvg.src} alt="" class="h-[34px] w-[20px]" />
            <span class="text-white-white font-['Orbitron'] text-2xl font-bold">
              Flashy
            </span>
          </a>
          <p
            class="text-body font-weight-body text-white-white-80 m-0 leading-[--text-body--line-height] tracking-[--text-body--letter-spacing]"
          >
            Built with Astro. Optimized to the core. Performance that converts.
          </p>
        </div>

        <a href="#contact" class="flex items-center gap-3 no-underline">
          <span
            class="text-body-semi-bold font-weight-body-semi-bold text-white-white leading-[--text-body-semi-bold--line-height]"
          >
            Contact Us
          </span>
          <span
            class="bg-orange flex items-center justify-center rounded-full p-[6.5px]"
          >
            <img src={arrowRight.src} alt="" class="size-[17px]" />
          </span>
        </a>
      </div>

      <!-- Right: columns -->
      <div class="flex gap-[100px]">
        <!-- Contact column -->
        <div class="flex flex-col gap-[18px]">
          <span
            class="text-body font-weight-body text-white-white-40 leading-[--text-body--line-height] tracking-[--text-body--letter-spacing]"
          >
            Contact
          </span>
          <div class="flex flex-col gap-[18px]">
            <a
              href="mailto:contact@flashy.com"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              contact@flashy.com
            </a>
            <a
              href="tel:+48985736245"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              +48 985736245
            </a>
          </div>
        </div>

        <!-- Pages column -->
        <div class="flex flex-col gap-[18px]">
          <span
            class="text-body font-weight-body text-white-white-40 leading-[--text-body--line-height] tracking-[--text-body--letter-spacing]"
          >
            Pages
          </span>
          <div class="flex flex-col gap-[18px]">
            <a
              href="#services"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              Services
            </a>
            <a
              href="#about"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              About Us
            </a>
            <a
              href="#contact"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              Contact
            </a>
            <a
              href="#blog"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              Blog
            </a>
          </div>
        </div>

        <!-- Connect column -->
        <div class="flex flex-col gap-[18px]">
          <span
            class="text-body font-weight-body text-white-white-40 leading-[--text-body--line-height] tracking-[--text-body--letter-spacing]"
          >
            Connect
          </span>
          <div class="flex flex-col gap-[18px]">
            <a
              href="#"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              LinkedIn
            </a>
            <a
              href="#"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              GitHub
            </a>
            <a
              href="#"
              class="text-links font-weight-links text-white-white-80 leading-[--text-links--line-height] no-underline"
            >
              X
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="bg-white-white-10 h-px w-full"></div>

    <!-- Bottom row -->
    <div class="flex items-center justify-between">
      <span
        class="text-body font-weight-body text-white-white-40 leading-[--text-body--line-height] tracking-[--text-body--letter-spacing]"
      >
        &copy; Flashy {new Date().getFullYear()}. All rights reserved.
      </span>
      <div class="flex gap-8">
        <a
          href="#"
          class="text-body-semi-bold font-weight-body-semi-bold text-white-white-40 leading-[--text-body-semi-bold--line-height] no-underline"
        >
          Term of Service
        </a>
        <a
          href="#"
          class="text-body-semi-bold font-weight-body-semi-bold text-white-white-40 leading-[--text-body-semi-bold--line-height] no-underline"
        >
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-card {
    display: flex;
    flex-direction: column;
    gap: 34px;
    padding: 34px 42px;
    border-radius: 12px;
    border: 2px solid var(--color-grey-grey-30);
    background: var(--color-white-white-5);
    overflow: hidden;
  }
</style>
